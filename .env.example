# DocIntel AI Configuration

# Answer generation provider: "local", "openai", or "gemini"
LLM_PROVIDER=local

# Embeddings are configured independently from answer generation.
# Supported profiles: local/local-hash-v1 (384), openai/text-embedding-3-small (1536),
# gemini/text-embedding-004 (768). Changing this profile requires a deliberate reindex.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=local-hash-v1

# API keys are backend-only. Never use VITE_ prefixes for secrets.
OPENAI_API_KEY=
GEMINI_API_KEY=

# ChromaDB persistence directory
CHROMA_PERSIST_DIR=./chroma_db

# Document storage directory
UPLOAD_DIR=./documents
DATA_DIR=./data

# Chunking settings
CHUNK_SIZE=500
CHUNK_OVERLAP=100
SIMILARITY_THRESHOLD=0.25
TOP_K_RESULTS=6

# Server host & port
HOST=0.0.0.0
PORT=8000

# Comma-separated frontend origins. Set to your deployed frontend origin in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to "production" on deployed backends.
APP_ENV=development

# Keep false in production. Enables POST /api/system/reset only for local development.
ALLOW_DESTRUCTIVE_RESET=false

# Optional frontend build-time backend URL; leave blank for the local Vite proxy.
VITE_API_BASE_URL=
